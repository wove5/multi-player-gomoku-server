{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Gomoku Game API",
    "description": "Open API documentation for Gomoku Game"
  },
  "servers": [
    {
      "url": "http://localhost:8081/api/api-docs"
    }
  ],
  "tags": [
    {
      "name": "game",
      "description": "All operations concerning a game"
    },
    {
      "name": "games",
      "description": "Operations retrieving details of multiple games"
    }
  ],
  "components": {
    "schemas": {
      "ObjectIdStringSchema": {
        "type": "string",
        "minLength": 24,
        "maxLength": 24,
        "pattern": "^[0-9A-Fa-f]+$",
        "description": "MongoDB ObjectId as a string"
      },
      "ObjectIdSchema": {
        "type": "string",
        "description": "Game Id | Player Id | Position Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
      },
      "GameSchema": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Game Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "user": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Player Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "_id": {
                          "type": "string",
                          "description": "Player Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
                        },
                        "userName": {
                          "type": "string",
                          "description": "Player's username"
                        }
                      },
                      "required": [
                        "_id",
                        "userName"
                      ]
                    }
                  ]
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "BLACK",
                    "WHITE",
                    "NONE"
                  ]
                }
              },
              "required": [
                "user",
                "color"
              ]
            }
          },
          "gameNumber": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "isMulti": {
            "type": "boolean"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 5,
              "maximum": 12
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Dimensions of the game board grid:\n\n must be numbers in the range 5..12"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "WON",
              "DRAWN"
            ]
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "description": "Game board Position Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "BLACK",
                    "WHITE",
                    "NONE"
                  ]
                }
              },
              "required": [
                "_id",
                "status"
              ]
            }
          },
          "selectedPositions": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "userId": {
                  "type": "string",
                  "minLength": 24,
                  "maxLength": 24,
                  "pattern": "^[0-9A-Fa-f]+$",
                  "description": "MongoDB ObjectId as a string"
                },
                "userName": {
                  "type": "string"
                }
              },
              "required": [
                "message",
                "userId",
                "userName"
              ]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date"
          },
          "updatedAt": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "_id",
          "players",
          "gameNumber",
          "isMulti",
          "size",
          "status",
          "positions",
          "selectedPositions",
          "messages",
          "createdAt",
          "updatedAt"
        ]
      },
      "IncompleteGamesArraySchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "_id": {
              "type": "string",
              "description": "Game Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
            },
            "gameNumber": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 5,
                "maximum": 12
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Dimensions of the game board grid:\n\n must be numbers in the range 5..12"
            },
            "isMulti": {
              "type": "boolean"
            },
            "createdAt": {
              "type": "string",
              "format": "date"
            },
            "players": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "user": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Player Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "_id": {
                            "type": "string",
                            "description": "Player Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
                          },
                          "userName": {
                            "type": "string",
                            "description": "Player's username"
                          }
                        },
                        "required": [
                          "_id",
                          "userName"
                        ]
                      }
                    ]
                  },
                  "color": {
                    "type": "string",
                    "enum": [
                      "BLACK",
                      "WHITE",
                      "NONE"
                    ]
                  }
                },
                "required": [
                  "user",
                  "color"
                ]
              }
            }
          },
          "required": [
            "_id",
            "gameNumber",
            "size",
            "isMulti",
            "createdAt",
            "players"
          ]
        }
      },
      "CompletedGamesArraySchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "_id": {
              "type": "string",
              "description": "Game Id:\n\nmongodb ObjectId = 24 character hexidecimal string"
            },
            "gameNumber": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 5,
                "maximum": 12
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Dimensions of the game board grid:\n\n must be numbers in the range 5..12"
            },
            "status": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "WON",
                "DRAWN"
              ]
            },
            "lastSelectedPosition": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "description": "Position Id of last selected board position:\n\nmongodb ObjectId = 24 character hexidecimal string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "BLACK",
                    "WHITE",
                    "NONE"
                  ]
                }
              },
              "required": [
                "_id",
                "status"
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date"
            },
            "updatedAt": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "_id",
            "gameNumber",
            "size",
            "status",
            "lastSelectedPosition",
            "createdAt",
            "updatedAt"
          ]
        }
      },
      "ServerErrorSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "Retrieve incomplete Games",
        "description": "Retrieve all incomplete games",
        "responses": {
          "200": {
            "description": "Retrieved incomplete games",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncompleteGamesArraySchema"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorSchema"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "game"
        ],
        "summary": "Create new Game",
        "description": "Create a new game",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "size": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 12
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "Dimensions of game grid: must be numbers in the range 5..12"
                  },
                  "isMulti": {
                    "type": "boolean",
                    "description": "Boolean flag indicates if game is multi-player or not"
                  }
                },
                "required": [
                  "size",
                  "isMulti"
                ]
              },
              "examples": {
                "eg1": {
                  "value": {
                    "size": "[5, 5]",
                    "isMulti": false
                  }
                },
                "eg2": {
                  "value": {
                    "size": "[10, 10]",
                    "isMulti": true
                  }
                },
                "eg3": {
                  "value": {
                    "size": "[7, 7]",
                    "isMulti": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Game created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSchema"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorSchema"
                }
              }
            }
          }
        }
      }
    },
    "/games": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "Retrieve completed Games",
        "description": "Retrieve all completed games",
        "responses": {
          "200": {
            "description": "Retrieved completed games",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedGamesArraySchema"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorSchema"
                }
              }
            }
          }
        }
      }
    },
    "/game/{id}": {
      "get": {
        "tags": [
          "game"
        ],
        "summary": "Retrieve incomplete Game",
        "description": "Retrieve an incompleted game",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The Game id number:\n\nmongodb ObjectId = 24 character hexidecimal string"
            },
            "required": true,
            "description": "The Game id number:\n\nmongodb ObjectId = 24 character hexidecimal string",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Game Object/document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSchema"
                }
              }
            }
          },
          "404": {
            "description": "Game not found in database"
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorSchema"
                }
              }
            }
          }
        }
      }
    },
    "/game-log/{id}": {
      "get": {
        "tags": [
          "game"
        ],
        "summary": "Retrieve completed Game",
        "description": "Retrieve a completed game",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The Game Id number:\n\nmongodb ObjectId = 24 character hexidecimal string"
            },
            "required": true,
            "description": "The Game Id number:\n\nmongodb ObjectId = 24 character hexidecimal string",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Game Object/document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSchema"
                }
              }
            }
          },
          "404": {
            "description": "Game not found in database"
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerErrorSchema"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}