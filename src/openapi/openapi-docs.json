{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Gomoku Game API",
    "description": "Open API documentation for Gomoku Game"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/api-docs"
    }
  ],
  "tags": [
    {
      "name": "game",
      "description": "All operations concerning a game"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/": {
      "post": {
        "tags": [
          "game"
        ],
        "description": "Create a new game",
        "summary": "Create Game",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "size": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 12
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "Dimensions of game grid: must be numbers in the range 5..12"
                  },
                  "isMulti": {
                    "type": "boolean",
                    "description": "Boolean flag indicates if game is multi-player or not"
                  }
                },
                "required": [
                  "size",
                  "isMulti"
                ]
              },
              "examples": {
                "eg1": {
                  "value": {
                    "size": "[5, 5]",
                    "isMulti": false
                  }
                },
                "eg2": {
                  "value": {
                    "size": "[10, 10]",
                    "isMulti": true
                  }
                },
                "eg3": {
                  "value": {
                    "size": "[7, 7]",
                    "isMulti": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Game created"
          }
        }
      }
    }
  },
  "webhooks": {}
}